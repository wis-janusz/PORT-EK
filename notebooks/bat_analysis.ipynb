    "    \"N\",\n",
    "    \"orf10\",\n",
    "    \"intergenic\",\n",
    "]\n",
    "PROTEIN_ORDER_LIST = [\n",
    "    \"nsp1\",\n",
    "    \"nsp2\",\n",
    "    \"nsp3\",\n",
    "    \"nsp4\",\n",
    "    \"nsp5\",\n",
    "    \"nsp6\",\n",
    "    \"nsp7\",\n",
    "    \"nsp8\",\n",
