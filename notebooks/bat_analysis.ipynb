    "    elif pos in range(19621, 20658 + 1):\n",
    "        protein = \"nsp15\"\n",
    "    elif pos in range(20659, 21555 + 1):\n",
    "        protein = \"nsp16\"\n",
    "    elif pos in range(21563, 25384 + 1):\n",
