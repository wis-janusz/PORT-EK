    "kmer_coverage.to_csv(f\"../output/bat/{k}mer_coverage.csv\")\n",
    "mutations.to_csv(f\"../output/bat/host_associated_mutations.csv\")\n",
    "mutation_coverage.to_csv(f\"../output/bat/host_associated_mutations_coverage.csv\")"
   ]
